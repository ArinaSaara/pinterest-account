# Скопіюйте у .env і впишіть свій токен із developers.pinterest.com
# Потрібні scope: boards:read, pins:read, pins:write
PINTEREST_ACCESS_TOKEN=
# Для Trial access можна використати sandbox: https://api-sandbox.pinterest.com/v5
PINTEREST_API_BASE=https://api.pinterest.com/v5

# Tumblr: ключі застосунку з https://www.tumblr.com/oauth/apps
# (Default callback URL і OAuth2 redirect: http://localhost:8080/callback)
TUMBLR_CONSUMER_KEY=
TUMBLR_CONSUMER_SECRET=
# Решту (TUMBLR_ACCESS_TOKEN, TUMBLR_REFRESH_TOKEN, TUMBLR_BLOG) допише `python3 post_tumblr.py auth`

# fal.ai (генерація відео зі стікерів): ключ з https://fal.ai/dashboard/keys
FAL_KEY=
